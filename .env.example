# ── قاعدة البيانات (Supabase → Project Settings → Database → Connection string)
# استخدم "Transaction pooler" (المنفذ 6543) عند النشر على Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── البث اللحظي في المتصفح (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── مفتاح أجهزة القراءة: يُرسل في الترويسة X-Device-Key مع POST /api/rfid/reads
RFID_DEVICE_KEY=change-me-to-a-long-random-string

# ── المحاكي
# أزرار سيناريوهات العرض داخل الواجهة (للمسؤول فقط). اتركها false في أي نشر عام.
SIMULATOR_ENABLED=true
# عنوان المنصة اللي يرسل لها محاكي سطر الأوامر (npm run sim)
SIMULATOR_BASE_URL=http://localhost:3000

# ── القواعد
# يُغلق استلام أمر الشراء بعد هذا العدد من الثواني بدون قراءات جديدة، ثم يُقارن المستلم بالمطلوب.
RECEIPT_IDLE_SECONDS=3
